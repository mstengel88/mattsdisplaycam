#!/bin/bash
### BEGIN INIT INFO
# Provides: omxplayer
# Required-Start: $network $local_fs dbus cron
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: Displays camera feeds for monitoring
# Description:
### END INIT INFO

#version:0.9.0

# Exit if not root
if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root"
   exit 0
fi

# Exit if config file is not present and readable
if [ -r /etc/displaycameras/displaycameras.conf ]; then
	. /etc/displaycameras/displaycameras.conf;
else
	echo "/etc/displaycameras/displaycameras.conf does not exist or is not readable."
	exit 1
fi

# Trixie no longer ships omxplayer.  Prefer the configured backend, or choose
# omxplayer on legacy installs and mpv everywhere else.
if [ "$player_backend" = "" ] || [ "$player_backend" = "auto" ]; then
	if command -v omxplayer >/dev/null 2>&1 && command -v omxplayer_dbuscontrol >/dev/null 2>&1; then
		player_backend="omxplayer"
	elif command -v mpv >/dev/null 2>&1; then
		player_backend="mpv"
	else
		echo "Please install omxplayer or mpv."
		exit 1
	fi
fi

case "$player_backend" in
omxplayer)
	if ! command -v omxplayer_dbuscontrol >/dev/null 2>&1; then
		echo "omxplayer_dbuscontrol must be executable and in the PATH env variable."
		exit 1
	fi
	if ! command -v omxplayer >/dev/null 2>&1; then
		echo "Please install omxplayer or set player_backend=mpv."
		exit 1
	fi
	;;
mpv)
	if ! command -v mpv >/dev/null 2>&1; then
		echo "Please install mpv or set player_backend=omxplayer."
		exit 1
	fi
	if ! command -v ffmpeg >/dev/null 2>&1; then
		echo "Please install ffmpeg for fullscreen 2x2 grid support."
		exit 1
	fi
	if ! command -v socat >/dev/null 2>&1; then
		echo "Please install socat for mpv status and repair support."
		exit 1
	fi
	if [[ $EUID -eq 0 ]] && ! command -v runuser >/dev/null 2>&1; then
		echo "Please install util-linux so mpv can run in the desktop user's session."
		exit 1
	fi
	;;
*)
	echo "Unsupported player_backend '$player_backend'. Use auto, omxplayer, or mpv."
	exit 1
	;;
esac

# Exit if default layout config file is not present and readable
if [ ! -r /etc/displaycameras/layout.conf.default ]; then
	echo "/etc/displaycameras/layout.conf.default does not exist or is not readable."
	exit 1
fi

# If enabled, autodetect display mode, check for layout config file for that
# mode, and load that file if present.
if [ "$displaydetect" = "true" ]; then
	boot_config=/boot/config.txt
	if [ ! -r "$boot_config" ] && [ -r /boot/firmware/config.txt ]; then
		boot_config=/boot/firmware/config.txt
	fi
	if [ "$player_backend" = "mpv" ] || { [ -r "$boot_config" ] && [ "`grep disable_overscan "$boot_config" | egrep -v ^#`" = "disable_overscan=1" ]; }; then
		if command -v xrandr >/dev/null 2>&1; then
			mode="`xrandr --current 2>/dev/null | awk '/\*/ {print $1; exit}'`"
		else
			mode="`fbset -s | egrep ^mode | awk -v N=2 '{print $2}'`"
			# remove quotes surrounding $mode
			mode=${mode%\"}
			mode=${mode#\"}
		fi
		if [ -r /etc/displaycameras/layout.conf.$mode ]; then
			. /etc/displaycameras/layout.conf.$mode
			displaydetectactive=true
		else
			. /etc/displaycameras/layout.conf.default
			echo "No layout configuration file found for $mode resolution."
		fi
	else
		. /etc/displaycameras/layout.conf.default
		echo "Display resolution autodetection will not work properly with overscan enabled."
		echo "Ensure disable_overscan=1 is in $boot_config."
	fi
else
	. /etc/displaycameras/layout.conf.default
fi

# Ensure there is an omxplayer timeout value
if [ "$omx_timeout" = "" ]; then
	omx_timeout=30
fi
if [ "$display_wait" = "" ]; then
	display_wait=90
fi
if [ "$grid_fps" = "" ]; then
	grid_fps=6
fi
if [ "$grid_refresh_minutes" = "" ]; then
	grid_refresh_minutes=15
fi

# Set a variables for PID file and Display Sequence file
PIDFILE=/var/run/displaycameras.pid
DISPLAY_SEQUENCE_FILE=/tmp/displaycameras.seq
MPV_RUNDIR=/var/run/displaycameras
MPV_LOGDIR=/var/log/displaycameras
MPV_GRID_NAME=grid
GRID_WIDTH=1920
GRID_HEIGHT=1080

# How many cameras do we have?
cameras="${#camera_names[@]}"
if [ "$player_backend" = "mpv" ] && [ "$cameras" -eq 4 ] && [ "$mpv_grid" = "" ]; then
	mpv_grid=true
fi
validation_failed=false
uses_srtp=false
if [ "$cameras" -eq 0 ]; then
	echo "No cameras are configured in /etc/displaycameras/layout.conf.default."
	validation_failed=true
fi
if [ "$cameras" -ne "${#camera_feeds[@]}" ]; then
	echo "camera_names and camera_feeds must contain the same number of entries."
	validation_failed=true
fi
if [ "$cameras" -gt "${#window_positions[@]}" ]; then
	echo "There must be at least as many window_positions as camera_names."
	validation_failed=true
fi
for i in ${!camera_feeds[*]}
do
	case "${camera_feeds[$i]}" in
	""|"<Camera stream URL>"|rtsp://user:password@camera-*.example/stream)
		echo "Camera feed for ${camera_names[$i]} still uses a placeholder URL."
		validation_failed=true
		;;
	rtsps://*enableSrtp*)
		uses_srtp=true
		;;
	esac
done
if [ "$player_backend" = "mpv" ] && [ "$mpv_grid" = "true" ] && [ "$uses_srtp" = "true" ]; then
	echo "UniFi SRTP feed detected; using mpv window grid mode instead of ffmpeg compositor."
	mpv_grid=windows
fi
if [ "$1" != "doctor" ] && [ "$validation_failed" = "true" ]; then
	exit 1
fi
# Set the max camera rotation sequence as one less than the number of cameras
# (since it starts at zero).
max_seq=$((cameras-1))
# Ensure sequence step value is reasonable
if [ "$seq_step" = "" ] || [ "$seq_step" -gt "$max_seq" ] || [ "$seq_step" -lt "1" ]; then
	seq_step=1
fi

# Figure out the current display sequence or set it to zero if it doesn't exist.
if [ ! -f $DISPLAY_SEQUENCE_FILE ]; then
	echo 0 > $DISPLAY_SEQUENCE_FILE
fi
declare -i DISPLAY_SEQUENCE
DISPLAY_SEQUENCE=`cat $DISPLAY_SEQUENCE_FILE`

#Functions

geometry_to_mpv() {
	read x1 y1 x2 y2 <<< "$1"
	width=$((x2 - x1 + 1))
	height=$((y2 - y1 + 1))
	echo "${width}x${height}+${x1}+${y1}"
}

mpv_socket() {
	echo "$MPV_RUNDIR/$1.sock"
}

mpv_pidfile() {
	echo "$MPV_RUNDIR/$1.pid"
}

mpv_logfile() {
	echo "$MPV_LOGDIR/$1.mpv.log"
}

mpv_grid_socket() {
	echo "$MPV_RUNDIR/$MPV_GRID_NAME.sock"
}

mpv_grid_pidfile() {
	echo "$MPV_RUNDIR/$MPV_GRID_NAME.pid"
}

mpv_grid_startfile() {
	echo "$MPV_RUNDIR/$MPV_GRID_NAME.started"
}

mpv_grid_logfile() {
	echo "$MPV_LOGDIR/$MPV_GRID_NAME.mpv.log"
}

mpv_display_env() {
	if [ "$display_user" = "" ]; then
		display_user=pi
	fi
	display_uid="`id -u "$display_user" 2>/dev/null`"
	if [ "$display_uid" = "" ]; then
		echo "Configured display_user '$display_user' does not exist."
		return 1
	fi
	if [ "$DISPLAY" = "" ]; then
		DISPLAY=:0
	fi
	if [ "$XDG_RUNTIME_DIR" = "" ] || [ "$XDG_RUNTIME_DIR" = "/run/user/1000" ]; then
		XDG_RUNTIME_DIR=/run/user/$display_uid
	fi
	if [ "$WAYLAND_DISPLAY" = "" ]; then
		if [ -S "$XDG_RUNTIME_DIR/wayland-1" ]; then
			WAYLAND_DISPLAY=wayland-1
		elif [ -S "$XDG_RUNTIME_DIR/wayland-0" ]; then
			WAYLAND_DISPLAY=wayland-0
		fi
	fi
	if [ "$XAUTHORITY" = "" ] && [ -r "/home/$display_user/.Xauthority" ]; then
		XAUTHORITY=/home/$display_user/.Xauthority
	fi
	waited=0
	while [ "$waited" -lt "$display_wait" ]
	do
		if [ -n "$WAYLAND_DISPLAY" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
			return 0
		fi
		display_number="${DISPLAY#:}"
		display_number="${display_number%%.*}"
		if [ -S "/tmp/.X11-unix/X$display_number" ]; then
			return 0
		fi
		sleep 1
		waited=$((waited+1))
	done
	echo "No graphical display was ready for $display_user after ${display_wait}s."
	return 1
}

mpv_command() {
	exec mpv --no-terminal --vo=x11 --force-window=yes --ontop --no-border --no-osc --no-input-default-bindings --cursor-autohide=always --title="displaycameras-$1" --geometry="$2" --profile=low-latency --network-timeout="$omx_timeout" --rtsp-transport=tcp --input-ipc-server="$3" "$4"
}

mpv_command_as_display_user() {
	exec runuser -u "$display_user" -- env DISPLAY="$DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" XAUTHORITY="$XAUTHORITY" XDG_SESSION_TYPE=x11 mpv --no-terminal --vo=x11 --force-window=yes --ontop --no-border --no-osc --no-input-default-bindings --cursor-autohide=always --title="displaycameras-$1" --geometry="$2" --profile=low-latency --network-timeout="$omx_timeout" --rtsp-transport=tcp --input-ipc-server="$3" "$4"
}

mpv_grid_filter() {
	tile_width=$((GRID_WIDTH / 2))
	tile_height=$((GRID_HEIGHT / 2))
	echo "[0:v]scale=${tile_width}:${tile_height}:force_original_aspect_ratio=decrease,pad=${tile_width}:${tile_height}:(ow-iw)/2:(oh-ih)/2[v0];[1:v]scale=${tile_width}:${tile_height}:force_original_aspect_ratio=decrease,pad=${tile_width}:${tile_height}:(ow-iw)/2:(oh-ih)/2[v1];[2:v]scale=${tile_width}:${tile_height}:force_original_aspect_ratio=decrease,pad=${tile_width}:${tile_height}:(ow-iw)/2:(oh-ih)/2[v2];[3:v]scale=${tile_width}:${tile_height}:force_original_aspect_ratio=decrease,pad=${tile_width}:${tile_height}:(ow-iw)/2:(oh-ih)/2[v3];[v0][v1][v2][v3]xstack=inputs=4:layout=0_0|${tile_width}_0|0_${tile_height}|${tile_width}_${tile_height}[stack];[stack]fps=${grid_fps}[v]"
}

mpv_grid_command() {
	ffmpeg -hide_banner -loglevel info -nostdin -rw_timeout 5000000 -timeout 5000000 -fflags nobuffer -flags low_delay -probesize 32768 -analyzeduration 1000000 -thread_queue_size 2 -rtsp_transport tcp -i "$3" -rw_timeout 5000000 -timeout 5000000 -fflags nobuffer -flags low_delay -probesize 32768 -analyzeduration 1000000 -thread_queue_size 2 -rtsp_transport tcp -i "$4" -rw_timeout 5000000 -timeout 5000000 -fflags nobuffer -flags low_delay -probesize 32768 -analyzeduration 1000000 -thread_queue_size 2 -rtsp_transport tcp -i "$5" -rw_timeout 5000000 -timeout 5000000 -fflags nobuffer -flags low_delay -probesize 32768 -analyzeduration 1000000 -thread_queue_size 2 -rtsp_transport tcp -i "$6" -filter_complex "$2" -map "[v]" -an -c:v rawvideo -pix_fmt yuv420p -flush_packets 1 -f nut - | exec mpv --no-terminal --fs --ontop --vo=wlshm,x11 --force-window=immediate --keep-open=always --no-border --no-osc --no-input-default-bindings --cursor-autohide=always --title="displaycameras-grid" --profile=low-latency --no-cache --input-ipc-server="$1" -
}

mpv_grid_command_as_display_user() {
	exec runuser -u "$display_user" -- env DISPLAY="$DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XAUTHORITY="$XAUTHORITY" XDG_SESSION_TYPE=wayland bash -c 'ffmpeg -hide_banner -loglevel info -nostdin -rw_timeout 5000000 -timeout 5000000 -fflags nobuffer -flags low_delay -probesize 32768 -analyzeduration 1000000 -thread_queue_size 2 -rtsp_transport tcp -i "$3" -rw_timeout 5000000 -timeout 5000000 -fflags nobuffer -flags low_delay -probesize 32768 -analyzeduration 1000000 -thread_queue_size 2 -rtsp_transport tcp -i "$4" -rw_timeout 5000000 -timeout 5000000 -fflags nobuffer -flags low_delay -probesize 32768 -analyzeduration 1000000 -thread_queue_size 2 -rtsp_transport tcp -i "$5" -rw_timeout 5000000 -timeout 5000000 -fflags nobuffer -flags low_delay -probesize 32768 -analyzeduration 1000000 -thread_queue_size 2 -rtsp_transport tcp -i "$6" -filter_complex "$2" -map "[v]" -an -c:v rawvideo -pix_fmt yuv420p -flush_packets 1 -f nut - | exec mpv --no-terminal --fs --ontop --vo=wlshm,x11 --force-window=immediate --keep-open=always --no-border --no-osc --no-input-default-bindings --cursor-autohide=always --title="displaycameras-grid" --profile=low-latency --no-cache --input-ipc-server="$1" -' _ "$1" "$2" "$3" "$4" "$5" "$6"
}

screen_test() {
	mpv_display_env || return 1
	if [ "$EUID" -eq 0 ]; then
		runuser -u "$display_user" -- env DISPLAY="$DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XAUTHORITY="$XAUTHORITY" XDG_SESSION_TYPE=wayland mpv --fs --ontop --vo=wlshm,x11 --force-window=immediate --keep-open=always --loop-file=inf --no-terminal --no-border --title=displaycameras-test av://lavfi:testsrc=size=1920x1080:rate=10
	else
		mpv --fs --ontop --vo=wlshm,x11 --force-window=immediate --keep-open=always --loop-file=inf --no-terminal --no-border --title=displaycameras-test av://lavfi:testsrc=size=1920x1080:rate=10
	fi
}

mpv_ipc() {
	socket="`mpv_socket "$1"`"
	if [ ! -S "$socket" ]; then
		return 1
	fi
	printf '%s\n' "$2" | socat -t 1 - "$socket" 2>/dev/null
}

mpv_get_property() {
	mpv_ipc "$1" "{\"command\":[\"get_property\",\"$2\"]}" | sed -n 's/.*"data":\([^,}]*\).*/\1/p' | tr -d '"'
}

player_getplaystatus() {
	case "$player_backend" in
	omxplayer)
		omxplayer_dbuscontrol "$1" getplaystatus
		;;
	mpv)
		pidfile="`mpv_pidfile "$1"`"
		socket="`mpv_socket "$1"`"
		if [ -r "$pidfile" ] && kill -0 "`cat "$pidfile"`" 2>/dev/null && [ -S "$socket" ]; then
			echo "Playing"
		elif [ -r "$pidfile" ] && kill -0 "`cat "$pidfile"`" 2>/dev/null; then
			echo "Starting"
		else
			echo "Stopped"
		fi
		;;
	esac
}

player_getposition() {
	case "$player_backend" in
	omxplayer)
		omxplayer_dbuscontrol "$1" getposition
		;;
	mpv)
		position="`mpv_get_property "$1" playback-time`"
		position="${position%.*}"
		if [ "$position" = "" ] || [ "$position" = "null" ]; then
			if [ "`player_getplaystatus "$1"`" = "Playing" ]; then
				position=1
			else
				position=0
			fi
		fi
		echo "${position}s"
		;;
	esac
}

player_status() {
	case "$player_backend" in
	omxplayer)
		omxplayer_dbuscontrol "$1" status 2>/dev/null
		;;
	mpv)
		status="`player_getplaystatus "$1"`"
		position="`player_getposition "$1"`"
		if [ "$status" = "Playing" ]; then
			echo "Playing mpv"
			echo "at $position"
		fi
		;;
	esac
}

player_quit() {
	case "$player_backend" in
	omxplayer)
		omxplayer_dbuscontrol "$1" quit
		;;
	mpv)
		mpv_ipc "$1" '{"command":["quit"]}' >/dev/null
		pidfile="`mpv_pidfile "$1"`"
		if [ -r "$pidfile" ]; then
			kill "`cat "$pidfile"`" 2>/dev/null
			rm -f "$pidfile" "`mpv_socket "$1"`"
		fi
		;;
	esac
}

grid_getplaystatus() {
	pidfile="`mpv_grid_pidfile`"
	socket="`mpv_grid_socket`"
	if [ -r "$pidfile" ] && kill -0 "`cat "$pidfile"`" 2>/dev/null && [ -S "$socket" ]; then
		echo "Playing"
	elif [ -r "$pidfile" ] && kill -0 "`cat "$pidfile"`" 2>/dev/null; then
		echo "Starting"
	else
		echo "Stopped"
	fi
}

grid_quit() {
	socket="`mpv_grid_socket`"
	if [ -S "$socket" ]; then
		printf '%s\n' '{"command":["quit"]}' | socat -t 1 - "$socket" >/dev/null 2>&1
	fi
	pidfile="`mpv_grid_pidfile`"
	if [ -r "$pidfile" ]; then
		kill "`cat "$pidfile"`" 2>/dev/null
		rm -f "$pidfile" "$socket"
	fi
	rm -f "`mpv_grid_startfile`"
	pkill -f 'title=displaycameras-grid' >/dev/null 2>&1
	pkill -f 'displaycameras-grid' >/dev/null 2>&1
	for i in "${camera_names[@]}"
	do
		player_quit "$i"
	done
	pkill -f 'displaycameras-' >/dev/null 2>&1
	killall mpv >/dev/null 2>&1
	killall ffmpeg >/dev/null 2>&1
}

start_mpv_grid() {
	if [ "$cameras" -lt 4 ]; then
		echo "mpv_grid requires at least four configured cameras."
		return 1
	fi
	grid_quit
	[ -d "$MPV_RUNDIR" ] || mkdir -p "$MPV_RUNDIR"
	[ -d "$MPV_LOGDIR" ] || mkdir -p "$MPV_LOGDIR"
	mpv_display_env || return 1
	if [ "$EUID" -eq 0 ]; then
		chown "$display_user" "$MPV_RUNDIR"
	fi
	socket="`mpv_grid_socket`"
	pidfile="`mpv_grid_pidfile`"
	startfile="`mpv_grid_startfile`"
	logfile="`mpv_grid_logfile`"
	filter="`mpv_grid_filter`"
	rm -f "$socket" "$pidfile"
	echo "Starting 2x2 grid at `date`" > "$logfile"
	echo "DISPLAY=$DISPLAY XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR WAYLAND_DISPLAY=$WAYLAND_DISPLAY XAUTHORITY=$XAUTHORITY" >> "$logfile"
	echo "grid_fps=$grid_fps grid_refresh_minutes=$grid_refresh_minutes" >> "$logfile"
	echo "feeds: ${camera_names[0]}, ${camera_names[1]}, ${camera_names[2]}, ${camera_names[3]}" >> "$logfile"
	if [ "$EUID" -eq 0 ]; then
		mpv_grid_command_as_display_user "$socket" "$filter" "${camera_feeds[0]}" "${camera_feeds[1]}" "${camera_feeds[2]}" "${camera_feeds[3]}" >> "$logfile" 2>&1 &
	else
		mpv_grid_command "$socket" "$filter" "${camera_feeds[0]}" "${camera_feeds[1]}" "${camera_feeds[2]}" "${camera_feeds[3]}" >> "$logfile" 2>&1 &
	fi
	pipeline_pid=$!
	echo $pipeline_pid > "$pidfile"
	date +%s > "$startfile"
	sleep 1
	if ! kill -0 "$pipeline_pid" 2>/dev/null; then
		echo "Grid pipeline exited immediately." >> "$logfile"
		return 1
	fi
}

start_player() {
	i="$1"
	x="$2"
	case "$player_backend" in
	omxplayer)
		player="omxplayer --no-keys --no-osd --avdict rtsp_transport:tcp --win \"${window_positions[$x]}\" \"${camera_feeds[$i]}\" --live -n -1 --timeout "$omx_timeout" --dbus_name "org.mpris.MediaPlayer2.omxplayer.${camera_names[$i]}" >/dev/null &"
		eval $player
		;;
	mpv)
		[ -d "$MPV_RUNDIR" ] || mkdir -p "$MPV_RUNDIR"
		[ -d "$MPV_LOGDIR" ] || mkdir -p "$MPV_LOGDIR"
		mpv_display_env || return 1
		if [ "$EUID" -eq 0 ]; then
			chown "$display_user" "$MPV_RUNDIR"
		fi
		socket="`mpv_socket "${camera_names[$i]}"`"
		pidfile="`mpv_pidfile "${camera_names[$i]}"`"
		logfile="`mpv_logfile "${camera_names[$i]}"`"
		rm -f "$socket" "$pidfile"
		geometry="`geometry_to_mpv "${window_positions[$x]}"`"
		echo "Starting ${camera_names[$i]} at `date`" > "$logfile"
		echo "DISPLAY=$DISPLAY XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR WAYLAND_DISPLAY=$WAYLAND_DISPLAY XAUTHORITY=$XAUTHORITY" >> "$logfile"
		if [ "$EUID" -eq 0 ]; then
			mpv_command_as_display_user "${camera_names[$i]}" "$geometry" "$socket" "${camera_feeds[$i]}" >> "$logfile" 2>&1 &
		else
			mpv_command "${camera_names[$i]}" "$geometry" "$socket" "${camera_feeds[$i]}" >> "$logfile" 2>&1 &
		fi
		echo $! > "$pidfile"
		;;
	esac
}

restart_mpv_players() {
	if [ "$player_backend" != "mpv" ]; then
		return
	fi
	for name in "${camera_names[@]}"
	do
		player_quit "$name"
	done
	sleep 1
	for i in ${!camera_names[*]}
	do
		x=$((i+$DISPLAY_SEQUENCE))
		if [ "$x" -ge "${#camera_names[@]}" ]; then x=$((x-${#camera_names[@]})); fi
		echo "Starting mpv for ${camera_names[$i]}"
		start_player "$i" "$x"
	done
}

case "$1" in
screen-test)
screen_test
;;

doctor)
echo "displaycameras doctor"
echo "backend: $player_backend"
echo "display_user: ${display_user:-pi}"
echo "mpv_grid: ${mpv_grid:-false}"
echo "grid_fps: $grid_fps"
echo "grid_refresh_minutes: $grid_refresh_minutes"
echo "cameras: $cameras"
if [ "$validation_failed" = "true" ]; then
	echo "config: FAILED"
else
	echo "config: ok"
fi
for i in ${!camera_names[*]}
do
	echo "$((i+1)). ${camera_names[$i]} -> ${window_positions[$i]} -> ${camera_feeds[$i]}"
done
case "$player_backend" in
mpv)
	if command -v mpv >/dev/null 2>&1; then echo "mpv: ok"; else echo "mpv: missing"; fi
	if command -v socat >/dev/null 2>&1; then echo "socat: ok"; else echo "socat: missing"; fi
	if command -v runuser >/dev/null 2>&1; then echo "runuser: ok"; else echo "runuser: missing"; fi
	mpv_display_env
	if [ $? -eq 0 ]; then
		echo "display session: ok"
		echo "DISPLAY=$DISPLAY"
		echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
		echo "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
		echo "XAUTHORITY=$XAUTHORITY"
	else
		echo "display session: FAILED"
	fi
	;;
esac
if [ "$validation_failed" = "true" ]; then
	exit 1
fi
;;

# Start displaying camera feeds
start)
if [ -f $PIDFILE ]; then
	echo "PID file exists; clearing stale displaycameras state before start."
	rm -f $PIDFILE
	grid_quit
	for i in "${camera_names[@]}"
	do
		player_quit "$i"
	done
	sleep 1
fi
if [ "$blank" = "true" ]; then
	echo "Blanking screen"
	fbi --noverbose -T 2 /usr/bin/black.png >/dev/null 2>&1 &
fi
if [ "$displaydetectactive" = "true" ]; then
	echo "Display detection is active for $mode resolution."
fi
if [ "$player_backend" = "mpv" ] && [ "$mpv_grid" = "true" ]; then
	echo "Starting mpv fullscreen 2x2 grid"
	start_mpv_grid
	sleep $startsleep
	startupretry=0
	while [ "`grid_getplaystatus`" != "Playing" ]
	do
		sleep 1
		echo "Waiting for mpv grid startup $startupretry"
		if [ "$startupretry" -eq "$retry" ]; then
			echo "mpv grid failed playback"
			echo "See `mpv_grid_logfile`"
			exit 1
		fi
		startupretry=$((startupretry+1))
	done
	touch $PIDFILE
	echo "Camera Display Started"
	echo "For complete status info, run"
	echo "/usr/bin/displaycameras status."
	exit 0
fi
startupfailure=false
feedfailure=false
for i in ${!camera_names[*]}
do
	startupretry=0
	feedretry=0
	x=$((i+$DISPLAY_SEQUENCE))
	if [ "$x" -ge "${#camera_names[@]}" ]; then x=$((x-${#camera_names[@]}))
	fi
	echo "Starting $player_backend for ${camera_names[$i]}"
	start_player "$i" "$x"
	sleep $startsleep
	while [ "`player_getplaystatus ${camera_names[$i]}`" != "Playing" ]
	do
		sleep 1
		echo "Waiting for ${camera_names[$i]} $player_backend startup $startupretry"
		if [ "$startupretry" -eq "$retry" ]; then
			break
		fi
		startupretry=$((startupretry+1))
	done
	if [ "`player_getplaystatus ${camera_names[$i]}`" = "Playing" ]
	then
		sleep $feedsleep
		while [ "`player_getposition ${camera_names[$i]}`" = "0s" ]
		do
			sleep 1
			echo "Waiting for ${camera_names[$i]} playback $feedretry"
			if [ "$feedretry" -eq "$retry" ]; then
				player_quit "${camera_names[$i]}"
				feedfailure=true
				break
			fi
		feedretry=$((feedretry+1))
		done
	else
		startupfailure=true
	fi
	if [ "`player_getplaystatus ${camera_names[$i]}`" = "Playing" ] && [ "`player_getposition ${camera_names[$i]}`" != "0s" ]; then
		echo "${camera_names[$i]} started"
	else
		echo "${camera_names[$i]} failed playback"
	fi
done
touch $PIDFILE
# One go at a repair job if not all displays start correctly
if [ "$startupfailure" = "true" ] || [ "$feedfailure" = "true" ]; then
	echo "Running a repair on failed feeds."
	$0 repair startup
fi
echo "Camera Display Started"
echo "For complete status info, run"
echo "/usr/bin/displaycameras status."
if [ "$rotate" = "true" ]; then
	if [ "$rotatedelay" = "" ]; then
		rotatedelay=5
	fi
	echo "Starting camera rotation"
	rotatedisplays $rotatedelay $seq_step &
fi
;;

# Stop displaying camera feeds
stop)
rm -f $PIDFILE
rm -f $DISPLAY_SEQUENCE_FILE
grid_quit
if [ "$rotate" = "true" ]; then
	pkill rotatedisplays
fi
for i in ${camera_names[@]}
do
	player_quit "$i"
done
sleep 2
if [ "$blank" = "true" ]; then
	pkill fbi
fi
killall omxplayer.bin > /dev/null 2>&1
killall mpv > /dev/null 2>&1
echo "Camera Display Stopped"
exit 0
;;

# Restart
restart)
$0 stop
sleep 1
$0 start
;;

# Restart any camera feeds that don't claim to be playing or restart the service
# if too many omxplayer.bin instances are active.
repair)
# Do nothing unless the service PID file exists
if [ ! -f $PIDFILE ]; then exit 0; fi
if [ "$player_backend" = "mpv" ] && [ "$mpv_grid" = "true" ]; then
	if [ "`grid_getplaystatus`" != "Playing" ]; then
		echo "Restarting mpv 2x2 grid"
		rm -f $PIDFILE
		grid_quit
		start_mpv_grid
		sleep $startsleep
		touch $PIDFILE
	elif [ "$grid_refresh_minutes" != "0" ]; then
		startfile="`mpv_grid_startfile`"
		if [ -r "$startfile" ]; then
			now="`date +%s`"
			started="`cat "$startfile"`"
			max_age=$((grid_refresh_minutes * 60))
			age=$((now - started))
			if [ "$age" -gt "$max_age" ]; then
				echo "Refreshing mpv 2x2 grid after ${age}s"
				rm -f $PIDFILE
				grid_quit
				start_mpv_grid
				sleep $startsleep
				touch $PIDFILE
			fi
		fi
	fi
	exit 0
fi
# Stop and start the service if we have too many omxplayers
if [ "$player_backend" = "omxplayer" ] && [ `pgrep -c omxplayer.bin` -gt $cameras ]
then
	$0 restart
fi
# The actual repair part
for i in ${!camera_names[*]}
do
	if [ "`player_getplaystatus ${camera_names[$i]}`" != "Playing" -o "`player_getposition ${camera_names[$i]}`" = "0s" ]
	then
		rm -f $PIDFILE
		pkill rotatedisplays
		player_quit "${camera_names[$i]}"
		x=$((i+$DISPLAY_SEQUENCE))
		if [ "$x" -ge "${#camera_names[@]}" ]; then x=$((x-${#camera_names[@]}))
		fi
		echo "Starting $player_backend for ${camera_names[$i]}"
		start_player "$i" "$x"
		sleep $startsleep
		startupretry=0
		feedretry=0
		while [ "`player_getplaystatus ${camera_names[$i]}`" != "Playing" ]
		do
			sleep 1
			echo "Waiting for ${camera_names[$i]} $player_backend startup $startupretry"
			if [ "$startupretry" -eq "$retry" ]; then
				break
			fi
			startupretry=$((startupretry+1))
		done
		if [ "`player_getplaystatus ${camera_names[$i]}`" = "Playing" ]
		then
			sleep $feedsleep
			while [ "`player_getposition ${camera_names[$i]}`" = "0s" ]
			do
				sleep 1
				echo "Waiting for ${camera_names[$i]} playback $feedretry"
				if [ "$feedretry" -eq "$retry" ]; then
					player_quit "${camera_names[$i]}"
					feedfailure=true
					break
				fi
				feedretry=$((feedretry+1))
			done
		else
			startupfailure=true
		fi
		if [ "`player_getplaystatus ${camera_names[$i]}`" = "Playing" ] && [ "`player_getposition ${camera_names[$i]}`" != "0s" ]; then
			echo "${camera_names[$i]} started"
		else
			echo "${camera_names[$i]} failed playback"
		fi
		touch $PIDFILE
		if [ "$rotate" = "true" ]; then
			if [ "$rotatedelay" = "" ]; then
				rotatedelay=5
			fi
			if [ "$2" != "startup" ]; then
				echo "Restarting camera rotation"
				rotatedisplays $rotatedelay $seq_step &
			fi
		fi
	fi
done
;;

rotate)
# Do nothing unless the service PID file exists
if [ ! -f $PIDFILE ]; then exit 0; fi
DISPLAY_SEQUENCE=$((DISPLAY_SEQUENCE-$seq_step))
if [ "$DISPLAY_SEQUENCE" -lt "0" ]; then
        DISPLAY_SEQUENCE="$max_seq"
fi
for i in ${!camera_names[*]}
do
	if [ "$player_backend" = "mpv" ]; then
		restart_mpv_players
		break
	fi
        y=$((i-DISPLAY_SEQUENCE-1))
        if [ "$y" -lt "0" ]; then y=$((y+"${#camera_names[@]}"))
        fi
        if [ "$y" -ge "${#camera_names[@]}" ]; then y=$((y-"${#camera_names[@]}"
))
        fi
        x=$((y+$DISPLAY_SEQUENCE))
        if [ "$x" -ge "${#camera_names[@]}" ]; then x=$((x-"${#camera_names[@]}"
))
        fi
        eval omxplayer_dbuscontrol "${camera_names[$y]}" setvideopos \"${window_positions[$x]}\"
done
echo $DISPLAY_SEQUENCE > $DISPLAY_SEQUENCE_FILE
;;

rotaterev)
if [ ! -f $PIDFILE ]; then exit 0; fi
DISPLAY_SEQUENCE=$((DISPLAY_SEQUENCE+$seq_step))
if [ "$DISPLAY_SEQUENCE" -ge "${#camera_names[@]}" ]; then
        DISPLAY_SEQUENCE=0
fi
for i in ${!camera_names[*]}
do
	if [ "$player_backend" = "mpv" ]; then
		restart_mpv_players
		break
	fi
        y=$((i-DISPLAY_SEQUENCE+1))
        if [ "$y" -lt "0" ]; then y=$((y+"${#camera_names[@]}"))
        fi
        if [ "$y" -ge "${#camera_names[@]}" ]; then y=$((y-"${#camera_names[@]}"))
        fi
        x=$((y+$DISPLAY_SEQUENCE))
        if [ "$x" -ge "${#camera_names[@]}" ]; then x=$((x-"${#camera_names[@]}"))
        fi
        eval omxplayer_dbuscontrol "${camera_names[$y]}" setvideopos \"${window_positions[$x]}\"
done
echo $DISPLAY_SEQUENCE > $DISPLAY_SEQUENCE_FILE
;;

status)
if [ "$player_backend" = "mpv" ] && [ "$mpv_grid" = "true" ]; then
	status="`grid_getplaystatus`"
	echo "2x2 grid is $status"
	exit 0
fi
for i in "${camera_names[@]}"
do
	status="`player_status $i`"
	if [[ "$status" != "Playing"* ]]; then
		echo "$i is NOT playing"
	else
		echo "$i is $status"
	fi
done
;;

positions)
for i in "${camera_names[@]}"
do
	position="`player_getposition $i`"
	echo "$position $i"
done
;;

*)
echo "Usage: /usr/bin/displaycameras {start|stop|restart|repair|status|positions|doctor|screen-test|rotate|rotaterev}"
exit 1
;;
esac
