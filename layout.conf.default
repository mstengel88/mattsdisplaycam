# Default four-camera 2x2 layout for a 1920x1080 display.
# Edit only camera_names and camera_feeds for your site.

windows=(upper_left upper_right lower_left lower_right)

window_positions=(
"0 0 959 539" \
"960 0 1919 539" \
"0 540 959 1079" \
"960 540 1919 1079" \
)

camera_names=(Camera1 Camera2 Camera3 Camera4)

camera_feeds=( \
"rtsp://user:password@camera-1.example/stream" \
"rtsp://user:password@camera-2.example/stream" \
"rtsp://user:password@camera-3.example/stream" \
"rtsp://user:password@camera-4.example/stream" \
)

rotate="false"
